{
 "sweep_id": "example_{{example}}",
 "description": "{{name}} on separable synthetic classes, against logistic regression, chosen by balanced accuracy on validation.",
 "purpose": "learning",
 "follows": [],
 "folds": ["fold1", "fold2", "fold3", "fold4"],
 "base": {
  "data": {"name": "synthetic", "generator": "classification", "n_rows": 600, "n_features": 6, "n_groups": 3, "noise": 1.0, "seed": 1},
  "split": {"name": "kfold", "k": 4, "stratify": "truth", "salt": "example", "identity_fold": false},
  "task": {"name": "classification", "target": "truth", "classes": ["c0", "c1", "c2"],
           "metrics": ["balanced_accuracy", "accuracy", "f1_macro"], "select": "balanced_accuracy", "groups": ["group"]},
  "prep": [{"name": "scale", "method": "zscore", "columns": ["*"], "per_group": null}],
  "features": {"name": "none"},
  "model": {"name": "{{name}}", "metric": "euclidean", "shrink_threshold": null, "extra": {}},
  "fit": {"name": "estimator", "device": "cpu", "control": "none", "refit": "train", "eval_train": false}
 },
 "stages": [
  {"name": "base", "kind": "base", "priority": 9, "seeds": [1, 2, 3]},
  {"name": "against", "kind": "variants", "priority": 8, "seeds": [1, 2, 3],
   "variants": {"logistic": {"model": {"name": "logistic_regression", "c": 1.0, "l1_ratio": 0.0, "class_weight": "none",
                                       "max_iter": 500, "extra": {}}},
                "manhattan": {"model.metric": "manhattan"}}},
  {"name": "control", "kind": "variants", "priority": 7, "seeds": [1, 2], "variants": {"shuffled": {"fit.control": "shuffle_train_labels"}}}
 ]
}
