{
 "sweep_id": "check_flow_mlp",
 "description": "The flow check (TESTING.md): a PyTorch network on the GPU (device cuda), one epoch only, on the uploaded table data/flow/classify.csv, with stratified 3-fold cross-validation; two other network shapes beside the base.",
 "purpose": "screen",
 "follows": [],
 "folds": [
  "fold1",
  "fold2",
  "fold3"
 ],
