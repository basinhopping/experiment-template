   "target": "truth",
   "classes": [
    "c0",
    "c1",
    "c2"
   ],
   "metrics": [
    "balanced_accuracy",
    "accuracy",
    "f1_macro",
    "log_loss"
   ],
   "select": "balanced_accuracy",
   "groups": [
    "group"
   ]
  },
  "prep": [
