   "max_iter": 5000,
   "extra": {}
  },
  "fit": {
   "name": "estimator",
   "device": "auto",
   "control": "none",
   "refit": "train",
   "eval_train": true
  }
 },
 "stages": [
  {
   "name": "base",
   "kind": "base",
   "priority": 9,
   "seeds": [
    1,
    2,
    3
   ]
  },
  {
   "name": "models",
