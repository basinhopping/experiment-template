      "min_samples_leaf": 20,
      "l2_regularization": 0.0,
      "early_stopping": false,
      "class_weight": "none",
      "extra": {}
     }
    }
   }
  },
  {
   "name": "control",
   "kind": "variants",
   "priority": 5,
   "seeds": [
    1,
    2,
    3
   ],
   "variants": {
