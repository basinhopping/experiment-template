{
 "sweep_id": "check_gpu_queue",
 "description": "The overnight queue check (TESTING.md): k-means and HDBSCAN through cuML on a GPU worker, in the rapids environment, run by node/schedule.sh's workers from the file queue. Every model here has a GPU path and fit.device is cuda, so a job that cannot see its GPU stops instead of running on the CPU.",
 "purpose": "learning",
 "follows": [],
 "folds": [
  "sub1",
  "sub2",
  "sub3"
 ],
 "base": {
  "data": {
   "name": "synthetic",
   "generator": "blobs",
   "n_rows": 50000,
   "n_features": 10,
   "n_groups": 8,
   "noise": 1.0,
   "seed": 1
  },
  "split": {
   "name": "subsamples",
   "k": 3,
   "fraction": 0.8,
   "salt": "check"
  },
  "task": {
   "name": "clustering",
   "criteria": [
    "silhouette",
    "n_clusters"
   ],
   "select": "silhouette",
   "sample_rows": 5000,
   "sample_salt": "check",
   "reference": "truth",
   "reveal_metrics": [
    "ari",
    "nmi"
   ],
   "criteria_options": {}
  },
  "prep": [
   {
    "name": "scale",
    "method": "zscore",
    "columns": [
     "*"
    ],
    "per_group": null
   }
  ],
  "features": {
   "name": "none"
  },
  "model": {
   "name": "kmeans",
   "n_clusters": 8,
   "init": "k-means++",
   "n_init": 4,
   "max_iter": 300,
   "tol": 0.0001,
   "extra": {}
  },
  "fit": {
   "name": "clusterer",
   "device": "cuda",
   "assign": "fit_rows"
  }
 },
 "stages": [
  {
   "name": "base",
   "kind": "base",
   "priority": 9,
   "seeds": [
    1,
    2
   ]
  },
  {
   "name": "k",
   "kind": "one_factor_at_a_time",
   "priority": 8,
   "seeds": [
    1,
    2
   ],
   "factors": {
    "model.n_clusters": [
     6,
     10
    ]
   }
  },
  {
   "name": "density",
   "kind": "variants",
   "priority": 7,
   "seeds": [
    1,
    2
   ],
   "variants": {
    "hdbscan": {
     "model": {
      "name": "hdbscan",
      "min_cluster_size": 500,
      "min_samples": 10,
      "cluster_selection_epsilon": 0.0,
      "cluster_selection_method": "eom",
      "allow_single_cluster": false,
      "metric": "euclidean",
      "extra": {}
     }
    }
   }
  }
 ]
}
