{
 "sweep_id": "example_cluster_graph",
 "description": "Communities of a nearest-neighbour graph (Leiden, Louvain, Markov clustering) against spectral clustering and affinity propagation, on planted groups, chosen by silhouette.",
 "purpose": "learning",
 "follows": [],
 "folds": [
  "sub1",
  "sub2",
  "sub3"
 ],
 "base": {
  "data": {
   "name": "synthetic",
   "generator": "planted_graph_points",
   "n_rows": 600,
   "n_features": 5,
   "n_groups": 4,
   "noise": 1.5,
   "seed": 1
  },
  "split": {
   "name": "subsamples",
   "k": 3,
   "fraction": 0.8,
   "salt": "example"
  },
  "task": {
   "name": "clustering",
   "criteria": [
    "silhouette",
    "dbcv",
    "n_clusters"
   ],
   "select": "silhouette",
   "sample_rows": 400,
   "sample_salt": "example",
   "reference": "truth",
   "reveal_metrics": [
    "ari",
    "ami",
    "nmi"
   ],
   "criteria_options": {}
  },
  "prep": [
   {
    "name": "scale",
    "method": "zscore",
    "columns": [
     "*"
    ],
    "per_group": null
   }
  ],
  "features": {
   "name": "none"
  },
  "model": {
   "name": "leiden",
   "n_neighbors": 15,
   "metric": "euclidean",
   "graph_search": "exact",
   "graph_weights": "connectivity",
   "resolution": 0.5,
   "quality": "modularity",
   "backend": "networkx",
   "extra": {}
  },
  "fit": {
   "name": "clusterer",
   "device": "auto",
   "assign": "fit_rows"
  }
 },
 "stages": [
  {
   "name": "base",
   "kind": "base",
   "priority": 9,
   "seeds": [
    1,
    2,
    3
   ]
  },
  {
   "name": "methods",
   "kind": "variants",
   "priority": 8,
   "seeds": [
    1,
    2,
    3
   ],
   "variants": {
    "leiden_jaccard": {
     "model.graph_weights": "jaccard"
    },
    "leidenalg": {
     "model.backend": "leidenalg"
    },
    "louvain": {
     "model": {
      "name": "louvain",
      "n_neighbors": 15,
      "metric": "euclidean",
      "graph_search": "exact",
      "graph_weights": "jaccard",
      "resolution": 0.5,
      "threshold": 1e-07,
      "extra": {}
     }
    },
    "markov": {
     "model": {
      "name": "markov",
      "n_neighbors": 30,
      "metric": "euclidean",
      "graph_search": "exact",
      "graph_weights": "connectivity",
      "expansion": 2,
      "inflation": 1.4,
      "self_loops": 1.0,
      "prune": 0.0001,
      "max_iter": 100,
      "tol": 1e-06
     }
    },
    "spectral": {
     "model": {
      "name": "spectral",
      "n_clusters": 4,
      "affinity": "nearest_neighbors",
      "gamma": 1.0,
      "n_neighbors": 10,
      "assign_labels": "kmeans",
      "n_init": 10,
      "extra": {}
     }
    },
    "affinity_propagation": {
     "model": {
      "name": "affinity_propagation",
      "damping": 0.9,
      "max_iter": 400,
      "convergence_iter": 25,
      "preference": -50.0,
      "extra": {}
     }
    }
   }
  },
  {
   "name": "settings",
   "kind": "one_factor_at_a_time",
   "priority": 7,
   "seeds": [
    1,
    2,
    3
   ],
   "factors": {
    "model.resolution": [
     0.25,
     1.0
    ],
    "model.n_neighbors": [
     30
    ]
   }
  }
 ]
}
