    },
    "global_normalization": {
     "features.normalization": "global"
    },
    "refit_train_and_val": {
     "fit.refit": "train_and_val"
    }
   }
  },
  {
   "name": "control",
   "kind": "variants",
   "priority": 6,
   "seeds": [
    1,
    2,
    3
   ],
   "variants": {
    "shuffled_labels": {
     "fit.control": "shuffle_train_labels"
    }
   }
  }
 ]
}
