    "target_sum": 10000.0,
    "n_quantiles": null,
    "output": null
   },
   {
    "name": "transform",
    "method": "log1p",
    "columns": [
     "*"
    ],
    "offset": null,
    "cofactor": null,
    "pseudocount": null,
    "reference": null,
    "target_sum": null,
    "n_quantiles": null,
    "output": null
   },
   {
    "name": "select_features",
