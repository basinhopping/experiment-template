{
 "sweep_id": "example_embed_manifold",
 "description": "Unrolling a swiss roll: Isomap against PCoA, metric and non-metric MDS, locally linear embedding (standard, modified, Hessian, LTSA) and spectral embedding, on subsamples whose rows are both fitted and evaluated (MDS and spectral embedding cannot place new rows), chosen by trustworthiness.",
 "purpose": "learning",
 "follows": [],
 "folds": [
  "sub1",
  "sub2",
  "sub3"
 ],
 "base": {
  "data": {
   "name": "synthetic",
   "generator": "swiss_roll",
   "n_rows": 600,
   "n_features": 3,
   "n_groups": 4,
   "noise": 0.05,
   "seed": 1
  },
  "split": {
   "name": "subsamples",
   "k": 3,
   "fraction": 0.8,
   "salt": "example"
  },
  "task": {
   "name": "embedding",
   "criteria": [
    "trustworthiness",
    "continuity",
    "knn_preservation"
   ],
   "select": "trustworthiness",
   "sample_rows": 300,
   "sample_salt": "example",
   "n_neighbors": 10,
   "reference": "truth",
   "reveal_metrics": [
    "knn_label_agreement",
    "reference_silhouette"
   ],
   "criteria_options": {}
  },
  "prep": [
   {
    "name": "scale",
    "method": "zscore",
    "columns": [
     "*"
    ],
    "per_group": null
   }
  ],
  "features": {
   "name": "none"
  },
  "model": {
   "name": "isomap",
   "n_components": 2,
   "n_neighbors": 10,
   "metric": "euclidean",
   "eigen_solver": "auto",
   "path_method": "auto",
   "extra": {}
  },
  "fit": {
   "name": "embedder",
   "device": "auto",
   "assign": "fit_rows"
  }
 },
